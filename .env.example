# Local ports
MASTER_WEB_PORT=3010
MASTER_API_PORT=8010

# PostgreSQL
POSTGRES_DB=wpservice
POSTGRES_USER=wpservice
POSTGRES_PASSWORD=wpservice

# Backend security
APP_SECRET_KEY=change-me-in-production

# Optional Cloudflare Tunnel.
# Keep this secret. Copy .env.example to .env and paste the token there.
CLOUDFLARE_TUNNEL_TOKEN=
